# ---- Python ----
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
.eggs/
build/
dist/
.Python

# ---- 虚拟环境 / uv ----
.venv/
venv/
env/
.uv/
uv.lock.bak

# ---- 环境变量（绝不入库）----
.env
.env.*
!.env.example

# ---- 测试与覆盖率 ----
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.mypy_cache/
.ruff_cache/

# ---- 日志与运行时数据 ----
*.log
logs/
log/
data/
uploads/

# ch10：这一章是数据章，语料与切分文件就是交付物，所以 data/topics 要进库。
# 写成 `data/*` + 反向规则，而不是直接 `data` —— 直接忽略 `data` 目录时
# git 根本不往目录里看，`!data/topics/` 再怎么否定都救不回来。
data/*
!data/topics/

# ch10：模型权重几百 MB，绝不能进库；只放行两个**小**的、要长期跟踪量的产物。
# 逐层写是因为 git 不会进入被排除的目录：想放行深层文件，就得先把每一层
# 父目录都重新包含进来（`models/` 一把梭会让后面的 `!` 全部失效）。
models/*
!models/topics/
models/topics/*
!models/topics/*/
models/topics/*/*
!models/topics/*/thresholds.json
!models/topics/*/metrics.json

# ch09：每轮评估的临时报告（趋势数据在 eval_runs 表里）
evals/reports/ch09-latest.json
evals/reports/ch09-latest.md

# ---- 编辑器 / 操作系统 ----
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db
desktop.ini

# ---- 沙箱产物（全局 uv cache 无写权限，缓存必须留在工作区内）----
.uv-cache/
.venv-probe/

# 沙箱会被「测试进程新建的目录」收回权限，导致这些目录删不掉；
# 忽略它们以免污染 git 状态。
pytest-cache-files-*/
pytest-cache/
pytest-tmp/


# Superpowers 执行器的临时工作区（ledger / briefs），不随代码提交
.superpowers/
data/topics/raw/
data/topics/clean/
data/topics/labeled/
data/topics/review/
data/topics/splits/
