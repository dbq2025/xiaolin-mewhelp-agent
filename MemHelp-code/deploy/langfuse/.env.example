# Langfuse 自部署配置模板：复制为 .env 后把 CHANGEME 换成真值。
# 生成密钥：openssl rand -hex 32（ENCRYPTION_KEY）、openssl rand -hex 16（SALT / NEXTAUTH_SECRET）
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=CHANGEME
SALT=CHANGEME
ENCRYPTION_KEY=CHANGEME

POSTGRES_USER=langfuse
POSTGRES_PASSWORD=CHANGEME
POSTGRES_DB=langfuse

CLICKHOUSE_USER=clickhouse
CLICKHOUSE_PASSWORD=CHANGEME
CLICKHOUSE_DB=default

REDIS_AUTH=CHANGEME
MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=CHANGEME

# 首次启动自动创建组织 / 项目 / 登录用户（仅用于本地开发）
LANGFUSE_INIT_ORG_ID=mewhelp
LANGFUSE_INIT_ORG_NAME=MewHelp
LANGFUSE_INIT_PROJECT_ID=mewhelp-ch09
LANGFUSE_INIT_PROJECT_NAME=mewhelp-ch09
LANGFUSE_INIT_PROJECT_PUBLIC_KEY=pk-lf-mewhelp-ch09
LANGFUSE_INIT_PROJECT_SECRET_KEY=sk-lf-mewhelp-ch09
LANGFUSE_INIT_USER_EMAIL=admin@mewhelp.local
LANGFUSE_INIT_USER_NAME=admin
LANGFUSE_INIT_USER_PASSWORD=CHANGEME
