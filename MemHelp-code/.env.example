# 上游：单个 OpenAI 兼容端点。换模型只改 OPENAI_MODEL。
OPENAI_BASE_URL=https://your-gateway.example.com/v1
OPENAI_API_KEY=sk-replace-me
OPENAI_MODEL=deepseek-chat
# 多轮历史裁剪预算（只统计历史消息，不含 System Prompt 与本轮问题）
CONTEXT_TOKEN_BUDGET=2000
REQUEST_TIMEOUT=60

# MySQL。两种接法，按你机器上的实际情况选一种：
#
# A) 复用**已有**的库（本机已有一个 mewhelp 库时需要）：
#    例如别的章节建的容器，通常只有 root 账号、跑在默认 3306。
#    **必须**先跑一次幂等迁移，把本章需要的 session_id 补上，
#    否则 ORM 会报 Unknown column：
#      uv run --directory MemHelp-code python scripts/migrate_existing.py \
#          --host 127.0.0.1 --port 3306 --user root --password root --database mewhelp
#
# B) 用本章自带的 compose 起一个干净的库（新库会自动建表灌数）：
#      docker compose -f MemHelp-code/docker-compose.yml up -d --wait
#    它映射在宿主 **3307**（刻意避开常被占用的 3306），
#    账号是 mewhelp/mewhelp，没有 root。
#
# 下面是 A 的默认值（库已存在、root 账号、3306）。
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=root
MYSQL_DATABASE=mewhelp

# 工具基础设施：单次执行超时（秒）与「仅对瞬时错误」的重试次数。
# 参数校验失败与业务性查不到**不重试**（重试也是同样结果，白等 2 倍超时）。
TOOL_TIMEOUT_SECONDS=3.0
TOOL_MAX_RETRIES=1

# ---- ch03：RAG（向量语义检索）----
# 嵌入走硅基流动的云端 API（OpenAI 兼容）。要用检索就必须填 EMBEDDING_API_KEY；
# 不填时离线测试照常跑，但建库/检索/评估会报一条可读错误。
MILVUS_URI=http://127.0.0.1:19530
MILVUS_COLLECTION=knowledge
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIM=1024
# 单次嵌入请求超时（秒）、每批条数、仅对 429/5xx 的重试次数
EMBEDDING_TIMEOUT=30
EMBEDDING_BATCH_SIZE=32
EMBEDDING_MAX_RETRIES=2
# 检索返回条数（也是 query_faq 的取数上限）
RAG_TOP_K=5
# 启动时预热：发一次真实嵌入请求 + 确认 Milvus 集合存在
RAG_WARMUP=true
# 切分：单块最大字符数 / 相邻块重叠上限（按句回退，绝不切半句）
CHUNK_MAX_CHARS=600
CHUNK_OVERLAP=80
# 对话挖知识：每批会话数 / 语义去重阈值
QA_BATCH_SIZE=8
QA_DEDUPE_THRESHOLD=0.92

# ---- ch04：混合检索 + 重排 ----
# 重排也用硅基流动（同一账户）。RERANK_API_KEY 留空则复用 EMBEDDING_API_KEY；
# 两者都空时重排自动降级为 RRF 序（只告警，不会让检索失败）。
RERANK_BASE_URL=https://api.siliconflow.cn/v1
RERANK_API_KEY=
RERANK_MODEL=BAAI/bge-reranker-v2-m3
RERANK_TIMEOUT=10
# 每一路（dense / BM25）各召回多少条 / 融合后进重排的候选数 / 最终证据条数
RAG_HYBRID_TOP_K=50
RAG_CANDIDATE_K=20
RAG_RERANK_TOP_N=10
# 检索层低置信阈值：最高重排分低于它就拒答并写 low_confidence_questions
RAG_MIN_RERANK_SCORE=0.3
# 口语问法是否调模型归一（关掉只走静态同义表，排障用）
RAG_QUERY_REWRITE=true
RAG_REWRITE_TIMEOUT=3
