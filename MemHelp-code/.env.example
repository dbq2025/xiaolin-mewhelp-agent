# 上游：单个 OpenAI 兼容端点。换模型只改 OPENAI_MODEL。
OPENAI_BASE_URL=https://your-gateway.example.com/v1
OPENAI_API_KEY=sk-replace-me
OPENAI_MODEL=deepseek-chat
# 多轮历史裁剪预算（只统计历史消息，不含 System Prompt 与本轮问题）
CONTEXT_TOKEN_BUDGET=2000
REQUEST_TIMEOUT=60

# MySQL。两种接法，按你机器上的实际情况选一种：
#
# A) 复用**已有**的库（本机已有一个 mewhelp 库时需要）：
#    例如别的章节建的容器，通常只有 root 账号、跑在默认 3306。
#    **必须**先跑一次幂等迁移，把本章需要的 session_id 补上，
#    否则 ORM 会报 Unknown column：
#      uv run --directory MemHelp-code python scripts/migrate_existing.py \
#          --host 127.0.0.1 --port 3306 --user root --password root --database mewhelp
#
# B) 用本章自带的 compose 起一个干净的库（新库会自动建表灌数）：
#      docker compose -f MemHelp-code/docker-compose.yml up -d --wait
#    它映射在宿主 **3307**（刻意避开常被占用的 3306），
#    账号是 mewhelp/mewhelp，没有 root。
#
# 下面是 A 的默认值（库已存在、root 账号、3306）。
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=root
MYSQL_DATABASE=mewhelp

# 工具基础设施：单次执行超时（秒）与「仅对瞬时错误」的重试次数。
# 参数校验失败与业务性查不到**不重试**（重试也是同样结果，白等 2 倍超时）。
TOOL_TIMEOUT_SECONDS=3.0
TOOL_MAX_RETRIES=1
